{
  "$ref": "#/definitions/progress-response",
  "definitions": {
    "progress-response": {
      "type": "object",
      "properties": {
        "progress": {
          "type": "object",
          "properties": {
            "streak_days": {
              "type": "integer",
              "minimum": 0
            },
            "filled_holes": {
              "type": "integer",
              "minimum": 0
            },
            "open_holes": {
              "type": "integer",
              "minimum": 0
            },
            "last_session_date": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "streak_days",
            "filled_holes",
            "open_holes",
            "last_session_date"
          ],
          "additionalProperties": false
        },
        "is_premium": {
          "type": "boolean"
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_seconds": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "remaining_sessions_today": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "max_seconds",
            "remaining_sessions_today"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "progress",
        "is_premium",
        "limits"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
