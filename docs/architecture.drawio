              <mxPoint x="800" y="290" />
              <mxPoint x="1240" y="290" />
              <mxPoint x="1240" y="420" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p1-e14" value="⑪復習プッシュ「後輩から質問です」" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p1-1" source="p1-x-onesignal" target="p1-karte-screen">
          <mxGeometry relative="1" as="geometry">
