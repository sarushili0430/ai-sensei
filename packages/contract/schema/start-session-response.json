{
  "$ref": "#/definitions/start-session-response",
  "definitions": {
    "start-session-response": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "new",
            "review"
          ]
        },
        "livekit": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "token": {
              "type": "string",
              "minLength": 1
            },
            "room": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "url",
            "token",
            "room"
          ],
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_seconds": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "lesson_allowed_today": {
              "type": "boolean"
            }
          },
          "required": [
            "max_seconds",
            "lesson_allowed_today"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "session_id",
        "kind",
        "livekit",
        "limits"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
