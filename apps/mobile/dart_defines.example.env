# =============================================================================
# apps/mobile — --dart-define で渡す値のテンプレート
# =============================================================================
# cp dart_defines.example.env dart_defines.env
# fvm flutter run --dart-define-from-file=dart_defines.env
#
# ここに入るのは**公開鍵とURLだけ**です。
# --dart-define の値はビルド成果物に埋め込まれ、逆アセンブルで読めます。
# 秘密鍵をここに書かないでください(サーバ側 = backend/ に置くこと)。
# =============================================================================

# --- backend/api のURL --------------------------------------------------------
# **末尾に `/` を付けないでください。** アプリは `$API_BASE_URL/v1/sessions` を
# 組み立てるので、付いていると `//v1/sessions` になり、どのルートにも当たらず
# 404(text/plain)が返ります。JSONとして読めないため、画面には
# 「うまく送れませんでした」としか出ません。
#   × https://ai-sensei-api-develop.example.workers.dev/
#   ○ https://ai-sensei-api-develop.example.workers.dev
# (アプリ側でも落とすようにしてありますが、他の設定ファイルは吸収しません)
#
# デプロイ済みのワーカーに当てる場合は、URLの取り違えを `GET /health` で
# 確かめられます。`{"ok":true,"environment":"develop"}` が返れば当たっています。
#
# **どこから見ているかで変わります。** ここを間違えると送信が必ず失敗し、
# 撮影画面には「うまく送れませんでした」としか出ません(サーバ側のエラーなら
# 「うまくいきませんでした。少し時間をおいて…」になるので、文言で切り分かります)。
#
#   iOSシミュレータ    http://localhost:8787
#   Androidエミュレータ http://10.0.2.2:8787   ← localhostはエミュレータ自身を指す
#   実機(iOS/Android)  http://<母艦のLAN IP>:8787(例: http://192.168.1.10:8787)
#
# 実機は母艦と同じWi-Fiに繋ぎ、`wrangler dev` を
# `pnpm --filter @ai-sensei/api dev -- --ip 0.0.0.0` で起動してください
# (既定ではlocalhostにしか口を開けません)。
API_BASE_URL=http://localhost:8787

# --- RevenueCat (クライアントSDK。公開鍵なので秘匿不要) ------------------------
# ストアに商品を作ったあとの本番用。iOSは appl_ 、Androidは goog_ で始まる。
REVENUECAT_IOS_PUBLIC_SDK_KEY=
REVENUECAT_ANDROID_PUBLIC_SDK_KEY=

# Test Store の鍵(test_ で始まる)。App Store Connect / Play Console に
# 商品を作る前でも購入フローを最後まで通せる、RevenueCat側の疑似ストア。
# **iOS/Androidで同じ値**を使う。上の2つが空のときだけ使われる。
REVENUECAT_SDK_KEY=

# ダッシュボードの Entitlement identifier(表示名ではないほう)。
# 空なら premium。ここがずれると、課金は成立するのに何も解放されない。
REVENUECAT_ENTITLEMENT_ID=premium

# 既定以外の Offering を出したいときだけ(価格の実験用)。空なら current。
REVENUECAT_OFFERING_ID=

# --- OneSignal (プッシュ受信。App IDは公開値) ---------------------------------
# REST API Key はサーバ側(backend/api)にあり、ここには置きません。
# backend/api の ONESIGNAL_APP_ID と**同じ値**にすること。
#
# アプリ側(push_repository.dart の PushConfig)は既定値を持たない。
# ここが空のビルドでは通知機能ごと無効になる(初期化も端末登録もしない)。
# CIでは codemagic.yaml が同じ値をフォールバックとして渡している。
ONESIGNAL_APP_ID=47044c5e-15eb-49ec-bdd4-e0ed2219a799

# --- Sentry (クラッシュ監視。DSNは公開前提の値) -------------------------------
SENTRY_DSN=

# --- 設定画面から出るリンク ---------------------------------------------------
# **ストア提出前に埋めること。** 空のあいだは設定画面に行ごと出ません
# (押しても開かない行を出さないため)。
#
# サブスクを載せる以上、プライバシーポリシーは審査で必ず見られます。
# 利用規約は自前のものが無ければ Apple の標準EULAのURLで構いません:
#   https://www.apple.com/legal/internet-services/itunes/dev/stdeula/
PRIVACY_POLICY_URL=
TERMS_URL=

# 後輩の質問がおかしかったときの報告先。
# AI生成コンテンツを含むアプリの導線として要ります(handoff §5)。
SUPPORT_EMAIL=
