          </mxGeometry>
        </mxCell>
        <mxCell id="p1-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=10;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="p1-1" source="p1-a-karte" target="p1-x-anthropic">
          <mxGeometry relative="1" as="geometry">
