          </mxGeometry>
        </mxCell>
        <mxCell id="p1-e11" value="⑧POST /complete&lt;br&gt;transcript + カルテ下書き" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="p1-1" source="p1-a-karte" target="p1-r-complete">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="820" y="568" />
              <mxPoint x="820" y="254" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p1-e12" value="③写真は R2 へ / ⑨カルテ・穴・予約は D1 へ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p1-1" source="p1-g-api" target="p1-g-cf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e13" value="⑩翌日 / 3日後 / 7日後を予約&lt;br&gt;（穴が埋まったら取消）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=blockThin;endFill=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p1-1" source="p1-r-complete" target="p1-x-onesignal">
          <mxGeometry relative="1" as="geometry">
