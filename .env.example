# =============================================================================
# ai-sensei — 環境変数テンプレート
# =============================================================================
# このリポジトリはpublicです。実値は絶対にコミットしないでください。
#   - workers/api : `cp .env.example workers/api/.dev.vars` (wrangler devが読む)
#                   本番は `wrangler secret put <NAME>` で登録する
#   - agent       : `cp .env.example agent/.env`
#   - apps/mobile : --dart-define / --dart-define-from-file で渡す(下部参照)
# =============================================================================

# --- LiveKit (リアルタイム会話) -----------------------------------------------
# LiveKit Cloud のプロジェクト設定から取得
LIVEKIT_URL=wss://example-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- LLM (会話 + カルテ生成) --------------------------------------------------
# 直叩き(Anthropic)かOpenRouter経由かを LLM_PROVIDER で切り替える
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# 会話用(低レイテンシ重視) / カルテ生成用(推論重視)でモデルを分けられる
LLM_MODEL_CONVERSATION=claude-haiku-4-5-20251001
LLM_MODEL_KARTE=claude-sonnet-5
# ノート写真の解析(Vision)
LLM_MODEL_VISION=claude-sonnet-5

# --- STT (日本語ストリーミング音声認識) ---------------------------------------
DEEPGRAM_API_KEY=

# --- TTS (後輩キャラの声) -----------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- OneSignal (間隔反復プッシュ: 翌日 / 3日後 / 7日後) ------------------------
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# --- RevenueCat (課金) --------------------------------------------------------
# webhookの Authorization ヘッダに設定する共有シークレット
REVENUECAT_WEBHOOK_AUTH=
# クライアント公開鍵(mobileにdart-defineで渡す。公開鍵なので秘匿不要)
REVENUECAT_IOS_PUBLIC_SDK_KEY=
REVENUECAT_ANDROID_PUBLIC_SDK_KEY=
REVENUECAT_ENTITLEMENT_ID=premium

# --- Sentry (監視) ------------------------------------------------------------
SENTRY_DSN=

# --- workers/api ---------------------------------------------------------------
# agent -> workers の内部呼び出し(/v1/sessions/{id}/complete)を保護する共有シークレット
INTERNAL_API_TOKEN=
# 無料枠(サーバ側で強制。クライアント改竄対策)
FREE_SESSIONS_PER_DAY=1
FREE_SESSION_MAX_SECONDS=300
PREMIUM_SESSION_MAX_SECONDS=900

# --- apps/mobile ----------------------------------------------------------------
# 例: flutter run --dart-define=API_BASE_URL=http://localhost:8787
API_BASE_URL=http://localhost:8787
