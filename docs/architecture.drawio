        <mxCell id="p1-e19" value="契約・カリキュラム・&lt;br&gt;ガードレール・プロンプト" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=10;endArrow=open;endFill=0;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0.15;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p1-1" source="p1-g-pkg" target="p1-g-api">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="350" y="619" />
