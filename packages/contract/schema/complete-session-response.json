{
  "$ref": "#/definitions/complete-session-response",
  "definitions": {
    "complete-session-response": {
      "type": "object",
      "properties": {
        "karte": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "session_id": {
              "type": "string",
              "minLength": 1
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            },
            "topic_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(M1|MA|M2|MB|M3|MC|A1|GE|A2|PC|CL|ST)-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
              },
              "minItems": 1
            },
            "said_well": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "maxItems": 10
            },
            "holes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "topic_id": {
                    "type": "string",
                    "pattern": "^(M1|MA|M2|MB|M3|MC|A1|GE|A2|PC|CL|ST)-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
                  },
                  "desc": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "evidence": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "open",
                      "filled"
                    ]
                  },
                  "created_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "filled_at": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "topic_id",
                  "desc",
                  "severity",
                  "id",
                  "status",
                  "created_at",
                  "filled_at"
                ],
                "additionalProperties": false
              },
              "maxItems": 5
            },
            "term_notes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "maxItems": 5
            },
            "followup_question": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "session_id",
            "created_at",
            "topic_ids",
            "said_well",
            "holes",
            "term_notes",
            "followup_question"
          ],
          "additionalProperties": false
        },
        "review_schedule": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hole_id": {
                "type": "string",
                "minLength": 1
              },
              "step": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "scheduled_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "hole_id",
              "step",
              "scheduled_at"
            ],
            "additionalProperties": false
          }
        },
        "progress": {
          "type": "object",
          "properties": {
            "streak_days": {
              "type": "integer",
              "minimum": 0
            },
            "filled_holes": {
              "type": "integer",
              "minimum": 0
            },
            "open_holes": {
              "type": "integer",
              "minimum": 0
            },
            "last_session_date": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "streak_days",
            "filled_holes",
            "open_holes",
            "last_session_date"
          ],
          "additionalProperties": false
        },
        "show_paywall": {
          "type": "boolean"
        }
      },
      "required": [
        "karte",
        "review_schedule",
        "progress",
        "show_paywall"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
