{
  "$ref": "#/definitions/board-lesson",
  "definitions": {
    "board-lesson": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "topic_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(M1|MA|M2|MB|M3|MC|A1|GE|A2|PC|CL|ST)-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 39
              },
              "speech": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^(?![\\s\\S]*\\\\[a-zA-Z])[\\s\\S]*$"
              },
              "board": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "latex"
                          },
                          "tex": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200,
                            "pattern": "^(?![\\s\\S]*\\\\begin\\{(?:align|gather|eqnarray|array|split|multline)\\*?\\})[\\s\\S]*$"
                          }
                        },
                        "required": [
                          "kind",
                          "tex"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "text"
                          },
                          "body": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          }
                        },
                        "required": [
                          "kind",
                          "body"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "plot"
                          },
                          "fn": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 80,
                            "pattern": "^(?:sin|cos|tan|sqrt|abs|log|ln|exp|pi|[-+*/^().,0-9x\\s])+$"
                          },
                          "domain": {
                            "type": "object",
                            "properties": {
                              "min": {
                                "type": "number",
                                "minimum": -1000,
                                "maximum": 1000
                              },
                              "max": {
                                "type": "number",
                                "minimum": -1000,
                                "maximum": 1000
                              }
                            },
                            "required": [
                              "min",
                              "max"
                            ],
                            "additionalProperties": false
                          },
                          "marks": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "at": {
                                  "type": "object",
                                  "properties": {
                                    "x": {
                                      "type": "number",
                                      "minimum": -1000,
                                      "maximum": 1000
                                    },
                                    "y": {
                                      "type": "number",
                                      "minimum": -1000,
                                      "maximum": 1000
                                    }
                                  },
                                  "required": [
                                    "x",
                                    "y"
                                  ],
                                  "additionalProperties": false
                                },
                                "label": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 24
                                }
                              },
                              "required": [
                                "at"
                              ],
                              "additionalProperties": false
                            },
                            "maxItems": 4
                          }
                        },
                        "required": [
                          "kind",
                          "fn",
                          "domain"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "triangle"
                          },
                          "vertices": {
                            "type": "array",
                            "minItems": 3,
                            "maxItems": 3,
                            "items": [
                              {
                                "type": "object",
                                "properties": {
                                  "x": {
                                    "type": "number",
                                    "minimum": -1000,
                                    "maximum": 1000
                                  },
                                  "y": {
                                    "type": "number",
                                    "minimum": -1000,
                                    "maximum": 1000
                                  }
                                },
                                "required": [
                                  "x",
                                  "y"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "x": {
                                    "type": "number",
                                    "minimum": -1000,
                                    "maximum": 1000
                                  },
                                  "y": {
                                    "type": "number",
                                    "minimum": -1000,
                                    "maximum": 1000
                                  }
                                },
                                "required": [
                                  "x",
                                  "y"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "x": {
                                    "type": "number",
                                    "minimum": -1000,
                                    "maximum": 1000
                                  },
                                  "y": {
                                    "type": "number",
                                    "minimum": -1000,
                                    "maximum": 1000
                                  }
                                },
                                "required": [
                                  "x",
                                  "y"
                                ],
                                "additionalProperties": false
                              }
                            ]
                          },
                          "labels": {
                            "type": "array",
                            "minItems": 3,
                            "maxItems": 3,
                            "items": [
                              {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 24
                              },
                              {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 24
                              },
                              {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 24
                              }
                            ]
                          },
                          "marks": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "vertex": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 2
                                },
                                "kind": {
                                  "type": "string",
                                  "enum": [
                                    "angle",
                                    "right_angle"
                                  ]
                                },
                                "label": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 24
                                }
                              },
                              "required": [
                                "vertex",
                                "kind"
                              ],
                              "additionalProperties": false
                            },
                            "maxItems": 3
                          }
                        },
                        "required": [
                          "kind",
                          "vertices"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "circle"
                          },
                          "center": {
                            "type": "object",
                            "properties": {
                              "x": {
                                "type": "number",
                                "minimum": -1000,
                                "maximum": 1000
                              },
                              "y": {
                                "type": "number",
                                "minimum": -1000,
                                "maximum": 1000
                              }
                            },
                            "required": [
                              "x",
                              "y"
                            ],
                            "additionalProperties": false
                          },
                          "r": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "maximum": 1000
                          },
                          "labels": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 24
                            },
                            "maxItems": 3
                          }
                        },
                        "required": [
                          "kind",
                          "center",
                          "r"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "figure"
                          },
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": {}
                            },
                            "minItems": 1,
                            "maxItems": 80
                          },
                          "svg": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 12000
                          },
                          "alt": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          }
                        },
                        "required": [
                          "kind",
                          "items"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "index",
              "speech",
              "board"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 12
        }
      },
      "required": [
        "title",
        "topic_ids",
        "steps"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
