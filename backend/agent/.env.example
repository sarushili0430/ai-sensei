# =============================================================================
# backend/agent — 環境変数テンプレート(LiveKit Agents)
# =============================================================================
# ローカル: cp .env.example .env
# 本番:     LiveKit Cloud のエージェント設定(またはコンテナの環境変数)
#
# このリポジトリはpublicです。実値は絶対にコミットしないでください。
# 足りない値があると**起動時に落ちます**(会話の途中で気づくのが最悪なので)。
# =============================================================================

# --- backend/api への接続 -----------------------------------------------------
# 会話が終わったらここへカルテを送る
API_BASE_URL=http://localhost:8787
# backend/api/.dev.vars の INTERNAL_API_TOKEN と同じ値にすること
INTERNAL_API_TOKEN=

# --- LiveKit (ルームへの参加) -------------------------------------------------
# **LiveKit Cloud のエージェントホスティングに載せるときは、この3つを渡さない。**
# 向こうが自分で注入するので、二重に入れると食い違ったときに気づきにくい。
LIVEKIT_URL=wss://example-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 名前つきで登録すると**明示ディスパッチ専用**になる(自動ディスパッチの対象外)。
# そのときは backend/api 側の LIVEKIT_AGENT_NAME にも同じ名前を入れること。
# 入れ忘れると部屋は作られるのに後輩が来ない。docs/deploy-agent.md §4
# LiveKit Cloud のホスティングはこれを自動で入れるので、手元では空でよい。
LIVEKIT_AGENT_NAME=

# --- LLM ----------------------------------------------------------------------
ANTHROPIC_API_KEY=
# 会話用(低レイテンシ重視)とカルテ生成用(推論重視)でモデルを分ける
LLM_MODEL_CONVERSATION=claude-haiku-4-5-20251001
LLM_MODEL_KARTE=claude-sonnet-5

# --- 音声 (聞く = Deepgram / 喋る = Gemini。ADR 0003 + ADR 0008) --------------
# 聞く側(STT)。TTSをGeminiへ移したので、この鍵はSTT専用になった。
DEEPGRAM_API_KEY=

# 喋る側(TTS)。Gemini API の鍵(AI Studio で発行する)。
GOOGLE_API_KEY=

# 先輩の声を作るモデル。**既定は `gemini-2.5-flash-preview-tts`。**
# 3.1 を試すときだけ `gemini-3.1-flash-tts-preview` を入れる。
# ここを空にすれば既定値で動く。恒久的に切り替えるなら、環境ごとにズレないよう
# backend/agent/src/senpai-voice.ts の定数を変える。
#
# 実在するのはこの3つだけ。**綴りに注意** — 2.5 は preview が tts の前、
# 3.1 は後ろに来る。存在しない名前を入れても起動は通り、最初に喋る瞬間に落ちる。
#   gemini-2.5-flash-preview-tts / gemini-2.5-pro-preview-tts /
#   gemini-3.1-flash-tts-preview
#   https://ai.google.dev/gemini-api/docs/speech-generation
GEMINI_TTS_MODEL=

# 喋らせ方。声のベンダーごと切り替わる1変数。
# `gemini` / `gemini-live` / `elevenlabs` / `cartesia`。
# 空なら `gemini`(= `google.beta.TTS`。1文ごとにHTTP)。
#
# **gemini-live のほうが高い。**音声出力 $12.00/1M(約 $0.018/分)で、gemini の
# $10.00/1M(約 $0.015/分)より2割高い。選ぶ理由は単価ではなく、1文ごとのHTTPが消えること。
#
# **gemini-live は対話モデルなので、逐語で読む保証が gemini より弱い。**要約・相槌・返答が
# 起きうる。板書と声がずれた瞬間に授業は成立しないので、入れたら必ず耳で確かめる。
#
# `elevenlabs` は下の ELEVENLABS_*、`cartesia` は下の CARTESIA_* が要る。
# 戻すのはこの1変数だけ。
#
# **旧 `GEMINI_TTS_ENGINE` は廃止。**残っていると起動時に落ちる(黙って gemini へ
# 戻るのを防ぐため)。値の対応は tts→gemini / live→gemini-live。
TTS_ENGINE=

# `TTS_ENGINE=gemini-live` のときのモデル。空なら 2.5(下の1つ目)。
#
# 公式ドキュメントで確認できたのはこの2つだけ。**プラグインの LiveAPIModels 型には
# 公式に無い名前が混じっている**ので信用しないこと(TTSの GeminiTTSModels と同じ罠。
# 存在しない名前でも起動は通り、最初に喋る瞬間に落ちる)。
#   gemini-2.5-flash-native-audio-preview-12-2025  … text入力 $0.50/1M
#   gemini-3.1-flash-live-preview                  … text入力 $0.75/1M(5割高い)
# 音声出力はどちらも $12.00/1M(約 $0.018/分)で同じ。
#   https://ai.google.dev/gemini-api/docs/models
GEMINI_LIVE_TTS_MODEL=

# --- ElevenLabs(`TTS_ENGINE=elevenlabs` のときだけ) ---------------------------
# 鍵と声IDは**この2つが揃っていないと起動時に落ちる**。無いと分かるのが
# 「最初に喋る瞬間」になるのを避けるため、engineを切り替えた時点で見る。
ELEVENLABS_API_KEY=

# 先輩の声のID(ElevenLabsのVoice Library / My Voicesで見る)。**既定値は無い。**
# プラグインの既定ボイスはElevenLabsが決めた誰かであって先輩ではないので、
# 選ばないまま喋り出すより落とす(`senpai-voice.ts`)。
ELEVENLABS_VOICE_ID=

# モデル。空なら `eleven_flash_v2_5`(32言語・日本語あり・公称 ~75ms)。
# **`_v2` と `_v2_5` の差がそのまま「英語のみ / 32言語」の差。**1文字違いで
# 日本語が喋れなくなる(Deepgramは言語がモデル名、ElevenLabsはバージョン番号に埋まっている)。
#   eleven_flash_v2_5      … 32言語・日本語あり
#   eleven_multilingual_v2 … 29言語・日本語あり(速さより質)
#   eleven_v3              … 70+言語・日本語あり
#   eleven_flash_v2        … **英語のみ**
#   https://elevenlabs.io/docs/models
ELEVENLABS_MODEL=

# --- Cartesia(`TTS_ENGINE=cartesia` のときだけ) -------------------------------
# 鍵と声IDは**この2つが揃っていないと起動時に落ちる**(ElevenLabsと同じ構え)。
CARTESIA_API_KEY=

# 先輩の声のID(CartesiaのPlayground / Voice Libraryで見る)。**既定値は無い。**
# プラグインの既定ボイス(`TTSDefaultVoiceId`)はCartesiaが決めた誰かであって
# 先輩ではないので、選ばないまま喋り出すより落とす(`senpai-voice.ts`)。
CARTESIA_VOICE_ID=

# モデル。空なら `sonic-3`(プラグイン既定と同じ安定版)。
# 実在するIDは backend/agent/src/senpai-voice.ts の cartesiaTtsModels が正。
# プラグインの型は sonic-3 止まりの素通しなので、型は実在を保証しない。
#   sonic-3              … プラグイン既定。公式は 3.5 への移行を案内している
#   sonic-3.5            … 最新安定。42言語(日本語あり)・公称 sub-90ms
#   sonic-3.5-2026-05-04 … 3.5 の日付固定版
#   sonic-preview        … β枠(8/17以降はSonic-3.6が乗る)。本番では使わない
#   https://docs.cartesia.ai/build-with-cartesia/tts-models/latest
CARTESIA_TTS_MODEL=

# 先輩の声は `Leda` に固定してある(ADR 0008)。**ふつうは触らない。**
# Geminiのボイスは言語を選ばないので、日英で同じ1つの声が喋る。
# 聴き比べたいときだけ `Kore` `Aoede` などを入れて上書きする。
#   https://ai.google.dev/gemini-api/docs/speech-generation
GEMINI_TTS_VOICE=

# --- 監視 ---------------------------------------------------------------------
# 設定するとジョブ中のエラー(カルテ生成・/complete 送信)がSentryへ飛ぶ。
# 未設定なら構造化ログ(1行1JSON)だけで動く。
SENTRY_DSN=
# Sentryのenvironmentに出る名前(develop / production)。
ENVIRONMENT=local
