  <diagram id="arch-deploy" name="6. 環境とデプロイ">
    <mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="p6-0" />
        <mxCell id="p6-1" parent="p6-0" />

        <mxCell id="p6-title" value="環境とデプロイ" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="p6-1">
          <mxGeometry x="40" y="12" width="700" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p6-repo" value="GitHub&lt;br&gt;sarushili0430/ai-sensei&lt;br&gt;（public / MIT）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p6-1">
          <mxGeometry x="60" y="180" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p6-dev" value="develop ブランチ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p6-1">
          <mxGeometry x="330" y="100" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p6-main" value="main ブランチ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p6-1">
          <mxGeometry x="330" y="290" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p6-mobilebr" value="apps/mobile の変更" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p6-1">
          <mxGeometry x="330" y="470" width="180" height="44" as="geometry" />
        </mxCell>

        <mxCell id="p6-ga-dev" value="GitHub Actions&lt;br&gt;wrangler d1 migrations apply →&lt;br&gt;wrangler deploy --env develop → /health 確認" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="p6-1">
          <mxGeometry x="580" y="86" width="300" height="72" as="geometry" />
        </mxCell>
        <mxCell id="p6-ga-prod" value="GitHub Actions&lt;br&gt;wrangler d1 migrations apply →&lt;br&gt;wrangler deploy --env production → /health 確認" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="p6-1">
          <mxGeometry x="580" y="276" width="300" height="72" as="geometry" />
        </mxCell>
        <mxCell id="p6-cm" value="Codemagic（codemagic.yaml）&lt;br&gt;fvm flutter test（契約fixture / ウィジェット / golden）→&lt;br&gt;iOS ビルド → TestFlight" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="p6-1">
          <mxGeometry x="580" y="456" width="300" height="72" as="geometry" />
        </mxCell>

        <mxCell id="p6-w-dev" value="&lt;b&gt;develop 環境&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Worker: ai-sensei-api-develop&lt;br&gt;D1: ai-sensei-develop&lt;br&gt;R2: ai-sensei-photos-develop&lt;br&gt;KV: METER（develop）&lt;br&gt;LiveKit: develop プロジェクト" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="p6-1">
          <mxGeometry x="960" y="60" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p6-w-prod" value="&lt;b&gt;production 環境&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Worker: ai-sensei-api-production&lt;br&gt;D1: ai-sensei-production&lt;br&gt;R2: ai-sensei-photos-production&lt;br&gt;KV: METER（production）&lt;br&gt;LiveKit: production プロジェクト" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="p6-1">
          <mxGeometry x="960" y="250" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p6-tf" value="TestFlight → App Store" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p6-1">
          <mxGeometry x="960" y="470" width="280" height="46" as="geometry" />
        </mxCell>

        <mxCell id="p6-agent" value="&lt;b&gt;backend/agent（LiveKit Agents）&lt;/b&gt;&lt;br&gt;常駐プロセスなので Workers には載らない。稼働先は ADR 0002 で保留中。&lt;br&gt;LiveKit のプロジェクトだけは環境ごとに必ず分ける&lt;br&gt;（共有すると開発用 agent が本番のルームのジョブを拾いうるため）。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="p6-1">
          <mxGeometry x="960" y="560" width="440" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p6-secrets" value="&lt;b&gt;秘匿値の置き場&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;・Workers: wrangler secret put &amp;lt;NAME&amp;gt; --env &amp;lt;develop|production&amp;gt;&lt;br&gt;　LIVEKIT_* / ANTHROPIC_API_KEY / ONESIGNAL_* / REVENUECAT_WEBHOOK_AUTH / INTERNAL_API_TOKEN&lt;br&gt;・agent: 実行環境の環境変数（.env はコミットしない）&lt;br&gt;・モバイル: 公開値のみ（--dart-define はビルド成果物から読める）&lt;br&gt;・pnpm run verify:secrets でコミット前に走査" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p6-1">
          <mxGeometry x="60" y="560" width="840" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p6-verify" value="pnpm run verify&lt;br&gt;lint（Biome）+ typecheck +&lt;br&gt;シークレット走査 + vitest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;dashed=1;fillColor=none;strokeColor=#9AA0A6;fontColor=#3C4043;" vertex="1" parent="p6-1">
          <mxGeometry x="60" y="300" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="p6-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="p6-1" source="p6-repo" target="p6-dev">
