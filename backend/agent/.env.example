# =============================================================================
# backend/agent — 環境変数テンプレート(LiveKit Agents)
# =============================================================================
# ローカル: cp .env.example .env
# 本番:     LiveKit Cloud のエージェント設定(またはコンテナの環境変数)
#
# このリポジトリはpublicです。実値は絶対にコミットしないでください。
# 足りない値があると**起動時に落ちます**(会話の途中で気づくのが最悪なので)。
# =============================================================================

# --- backend/api への接続 -----------------------------------------------------
# 会話が終わったらここへカルテを送る
API_BASE_URL=http://localhost:8787
# backend/api/.dev.vars の INTERNAL_API_TOKEN と同じ値にすること
INTERNAL_API_TOKEN=

# --- LiveKit (ルームへの参加) -------------------------------------------------
LIVEKIT_URL=wss://example-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- LLM ----------------------------------------------------------------------
ANTHROPIC_API_KEY=
# 会話用(低レイテンシ重視)とカルテ生成用(推論重視)でモデルを分ける
LLM_MODEL_CONVERSATION=claude-haiku-4-5-20251001
LLM_MODEL_KARTE=claude-sonnet-5

# --- 音声 (STT / TTS はどちらもDeepgram。ADR 0003) ----------------------------
# 聞く側と喋る側で鍵は共通
DEEPGRAM_API_KEY=

# 後輩の声(日本語)。`aura-2-<voice>-ja` の形で、Deepgramのボイス一覧から選ぶ。
#   https://developers.deepgram.com/docs/tts-models
# **既定値は無い。** 声はキャラクターそのものなので、必ず自分で選ぶこと。
DEEPGRAM_TTS_MODEL_JA=

# 英語ロケール(審査・デモ用)の声。Deepgramは言語がモデル名に埋まっていて、
# 日本語ボイスは英語を喋れないので、別に持つ。未設定なら既定値で動く。
DEEPGRAM_TTS_MODEL_EN=aura-2-andromeda-en

# --- 監視 ---------------------------------------------------------------------
# 設定するとジョブ中のエラー(カルテ生成・/complete 送信)がSentryへ飛ぶ。
# 未設定なら構造化ログ(1行1JSON)だけで動く。
SENTRY_DSN=
# Sentryのenvironmentに出る名前(develop / production)。
ENVIRONMENT=local
