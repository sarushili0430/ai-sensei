{
  "$ref": "#/definitions/complete-session-response",
  "definitions": {
    "complete-session-response": {
      "type": "object",
      "properties": {
        "practice_problem": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "topic_id": {
                  "type": "string",
                  "pattern": "^(M1|MA|M2|MB|M3|MC|A1|GE|A2|PC|CL|ST|J1|J2|J3|JE|E1|E2|L1)-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
                },
                "question": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "session_id": {
                  "type": "string",
                  "minLength": 1
                },
                "board_id": {
                  "type": "string",
                  "minLength": 1
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "topic_id",
                "question",
                "id",
                "session_id",
                "board_id",
                "created_at"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "practice_schedule": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "problem_id": {
                "type": "string",
                "minLength": 1
              },
              "step": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "days": {
                "type": "integer",
                "minimum": 1
              },
              "scheduled_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "problem_id",
              "step",
              "days",
              "scheduled_at"
            ],
            "additionalProperties": false
          }
        },
        "progress": {
          "type": "object",
          "properties": {
            "streak_days": {
              "type": "integer",
              "minimum": 0
            },
            "filled_holes": {
              "type": "integer",
              "minimum": 0
            },
            "open_holes": {
              "type": "integer",
              "minimum": 0
            },
            "solved_problems": {
              "type": "integer",
              "minimum": 0
            },
            "open_problems": {
              "type": "integer",
              "minimum": 0
            },
            "last_session_date": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "streak_days",
            "filled_holes",
            "open_holes",
            "solved_problems",
            "open_problems",
            "last_session_date"
          ],
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_seconds": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "remaining_seconds_today": {
              "type": "integer",
              "minimum": 0
            },
            "lesson_allowed_today": {
              "type": "boolean"
            }
          },
          "required": [
            "max_seconds",
            "remaining_seconds_today",
            "lesson_allowed_today"
          ],
          "additionalProperties": false
        },
        "show_paywall": {
          "type": "boolean"
        }
      },
      "required": [
        "practice_problem",
        "practice_schedule",
        "progress",
        "limits",
        "show_paywall"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
