{
  "$ref": "#/definitions/karte",
  "definitions": {
    "karte": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "topic_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(M1|MA|M2|MB|M3|MC|A1|GE|A2|PC|CL|ST)-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
          },
          "minItems": 1
        },
        "said_well": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 10
        },
        "holes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "topic_id": {
                "type": "string",
                "pattern": "^(M1|MA|M2|MB|M3|MC|A1|GE|A2|PC|CL|ST)-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
              },
              "desc": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "severity": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "evidence": {
                "type": "string",
                "maxLength": 500
              },
              "quiz": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "filled"
                ]
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "filled_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "topic_id",
              "desc",
              "severity",
              "id",
              "status",
              "created_at",
              "filled_at"
            ],
            "additionalProperties": false
          },
          "maxItems": 5
        },
        "term_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 5
        },
        "followup_question": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "session_id",
        "created_at",
        "topic_ids",
        "said_well",
        "holes",
        "term_notes",
        "followup_question"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
