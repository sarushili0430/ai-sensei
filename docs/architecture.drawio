        <mxCell id="p1-e17" value="購入 / 復元" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p1-1" source="p1-paywall" target="p1-x-revenuecat">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
