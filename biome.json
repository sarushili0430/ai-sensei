{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignore": [
      "**/dist",
      "**/.wrangler",
      "apps/mobile",
      "packages/contract/schema",
      "packages/prompts/src/generated.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "trailingCommas": "all" }
  },
  "json": {
    "formatter": { "enabled": true, "lineWidth": 100 },
    "parser": { "allowComments": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off",
        "useNamingConvention": "off"
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "overrides": [
    {
      "include": ["**/*.test.ts", "scripts/**"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    },
    {
      "include": [
        "packages/figure/src/solve.js",
        "packages/figure/src/render.js",
        "docs/figeval/**"
      ],
      "linter": {
        "rules": {
          "complexity": { "noForEach": "off" },
          "suspicious": { "noExplicitAny": "off" }
        }
      }
    }
  ]
}
