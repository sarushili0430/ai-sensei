{
  "$ref": "#/definitions/create-session-response",
  "definitions": {
    "create-session-response": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "new",
            "review"
          ]
        },
        "livekit": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "token": {
              "type": "string",
              "minLength": 1
            },
            "room": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "url",
            "token",
            "room"
          ],
          "additionalProperties": false
        },
        "detected_topics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "topic_id": {
                "type": "string",
                "pattern": "^(M1|MA|M2|MB|M3|MC|A1|GE|A2|PC|CL|ST)-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
              },
              "course": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "topic": {
                "type": "string",
                "minLength": 1
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "topic_id",
              "course",
              "unit",
              "topic",
              "confidence"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "problem": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "problem_photo",
                    "notes_photo"
                  ]
                }
              },
              "required": [
                "text",
                "source"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_seconds": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "lesson_allowed_today": {
              "type": "boolean"
            }
          },
          "required": [
            "max_seconds",
            "lesson_allowed_today"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "session_id",
        "kind",
        "livekit",
        "detected_topics",
        "problem",
        "limits"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
