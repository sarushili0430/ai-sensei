        <mxCell id="p1-title" value="ai-sensei — 全体構成（現状）" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="p1-1">
          <mxGeometry x="40" y="8" width="640" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p1-caption" value="&lt;b&gt;①〜⑫ は新規セッション1回分の流れ。&lt;/b&gt;会話だけが WebRTC（LiveKit）で、それ以外は HTTPS。&lt;br&gt;質問の範囲は二重ガード：④で「写真に写っている内容 ∩ カリキュラムマップ」、⑧で穴の topic_id を許可リスト照合。&lt;br&gt;認証は匿名デバイスID（X-Device-Id）だけ。アカウント作成は要求しない。" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#9AA0A6;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontColor=#3C4043;" vertex="1" parent="p1-1">
          <mxGeometry x="700" y="46" width="520" height="74" as="geometry" />
        </mxCell>

