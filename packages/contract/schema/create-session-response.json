{
  "$ref": "#/definitions/create-session-response",
  "definitions": {
    "create-session-response": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "new",
            "review"
          ]
        },
        "detected_topics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "topic_id": {
                "type": "string",
                "pattern": "^(M1|MA|M2|MB|M3|MC|A1|GE|A2|PC|CL|ST|J1|J2|J3|JE|E1|E2|L1)-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
              },
              "course": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "topic": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "topic_id",
              "course",
              "unit",
              "topic",
              "label",
              "confidence"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "problem": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "problem_photo",
                    "notes_photo",
                    "manual"
                  ]
                }
              },
              "required": [
                "text",
                "source"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "problem_outcome": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "read",
                "not_found",
                "too_long",
                "solution_included",
                "not_a_problem"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "session_id",
        "kind",
        "detected_topics",
        "problem",
        "problem_outcome"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
