{
  "name": "ai-sensei",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.6",
    "pnpm": ">=10"
  },
  "scripts": {
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "verify:secrets": "node --experimental-strip-types scripts/verify-no-secrets.ts",
    "verify:bindings": "node --experimental-strip-types scripts/verify-wrangler-bindings.ts",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run verify:secrets && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
