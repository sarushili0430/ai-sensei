              <mxPoint x="332" y="845" />
              <mxPoint x="332" y="324" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p1-e15" value="⑫GET /result（202 の間はポーリング）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=blockThin;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p1-1" source="p1-karte-screen" target="p1-r-result">
          <mxGeometry relative="1" as="geometry" />
